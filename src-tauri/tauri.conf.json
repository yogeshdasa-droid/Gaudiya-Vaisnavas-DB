{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaudiya Vaisnavas DB",
  "version": "0.12.1",
  "identifier": "com.whispers.biodata",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gaudiya Vaisnavas DB",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gaudiya Vaisnavas DB: biografias vaisnavas",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQzY0RDJDOURFRTIyMDAKUldRQUl1NmRMRTNHbytQM3I3U2FHellFeml3Wnl3MWJSaGFmU1BVSnpHbC9FbHFWTmtmV3ZaY0oK",
      "endpoints": [
        "https://github.com/yogeshdasa-droid/Gaudiya-Vaisnavas-DB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
